reports/v1.1.0/artifacts/**/*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
reports/v1.2.0/artifacts/**/*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Retained evidence preserves exact original diagnostic bytes.
reports/v1.2.0/evidence/** -whitespace

# v1.8 public inputs and verified outputs retain their exact oracle-bound bytes.
reports/v1.8.0/**/fixtures/** -text -whitespace
reports/v1.8.0/**/output.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
